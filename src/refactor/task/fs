const rawData = useRawData();

const [selectedDate, setSelectedDate] = useUrlSync<T>('ttv-date', value: T, dateSerializer);
const [selectedChains, setSelectedChains] = useUrlSync<T>('ttv-chain', value: T);
const [selectedMarkets, setSelectedMarkets] = useUrlSync<T>('ttv-market', value: T);

const [groupByValue, setGroupByValue] = useUrlSync<T>('ttv-group-by', value: T);

const chains = useMemo(() => rawData.map(v => v.chain).unique().sort()), [rawData]);

const markets = useMemo(() => rawData.filter(v => selectedChains.includes(v.chain)).map(v => v.market).unique().sort()), [rawData]);

const series = useProcessor({
    array: T[],
    filters: [
        (v: T) => selectedChains.includes(v.chain),
        (v: T) => selectedDate.getTime() >= v.timestamp.getTime()
    ],
    transformer: () => {
        const series = {} as {
            [chain: number]: T[]
        };

        return (v: T) => {
            if (v.chain in series) {
                series[v.chain].push(v);
            } else {
                series[v.chain] = [v];
            }

            return series;
        }
    }
});

const onClick = () => {
